<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recipes -->
    <record id="view_mos_recipe_list" model="ir.ui.view">
        <field name="name">mos.recipe.list</field>
        <field name="model">mos.recipe</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="target_extraction_pct"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_mos_recipe_form" model="ir.ui.view">
        <field name="name">mos.recipe.form</field>
        <field name="model">mos.recipe</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_new_version" string="New version" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="target_extraction_pct"/>
                            <field name="extraction_tolerance"/>
                            <field name="grist_tolerance"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="wheat_id"/>
                            <field name="share_pct" sum="Total"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Why this blend"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_recipe" model="ir.actions.act_window">
        <field name="name">Recipes</field>
        <field name="res_model">mos.recipe</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Milling run: the recipe -->
    <record id="view_mos_milling_run_form_recipe" model="ir.ui.view">
        <field name="name">mos.milling.run.form.recipe</field>
        <field name="model">mos.milling.run</field>
        <field name="inherit_id" ref="mos_production.view_mos_milling_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shift']" position="after">
                <field name="recipe_id"/>
                <field name="work_order_id"/>
            </xpath>
        </field>
    </record>

    <!-- Work orders -->
    <record id="view_mos_work_order_list" model="ir.ui.view">
        <field name="name">mos.work.order.list</field>
        <field name="model">mos.work.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('done', 'cancelled')" decoration-info="state == 'running'">
                <field name="name"/>
                <field name="date"/>
                <field name="shift"/>
                <field name="product_id"/>
                <field name="planned_kg"/>
                <field name="actual_wheat_kg"/>
                <field name="work_centre_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_mos_work_order_form" model="ir.ui.view">
        <field name="name">mos.work.order.form</field>
        <field name="model">mos.work.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" string="Plan the wheat" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start the run" type="object" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_finish" string="Finish" type="object" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,running,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="kind"/>
                            <field name="recipe_id"/>
                            <field name="planned_kg"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="shift"/>
                            <field name="work_centre_id"/>
                            <field name="supervisor_id"/>
                            <field name="run_id"/>
                        </group>
                    </group>
                    <group invisible="not run_id">
                        <field name="actual_wheat_kg"/>
                        <field name="actual_flour_kg"/>
                        <field name="actual_extraction"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="wheat_id"/>
                            <field name="silo_id"/>
                            <field name="qty_kg" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_mos_work_order_search" model="ir.ui.view">
        <field name="name">mos.work.order.search</field>
        <field name="model">mos.work.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="mine" string="Mine" domain="[('supervisor_id', '=', uid)]"/>
                <filter name="open" string="Not finished" domain="[('state', 'in', ('draft', 'planned', 'running'))]"/>
            </search>
        </field>
    </record>
    <record id="action_mos_work_order" model="ir.actions.act_window">
        <field name="name">Work orders</field>
        <field name="res_model">mos.work.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mos_my_orders_today" model="ir.actions.act_window">
        <field name="name">My orders today</field>
        <field name="res_model">mos.work.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1, 'search_default_mine': 1, 'search_default_open': 1}</field>
    </record>

    <!-- Silos: strapping, dips, holds -->
    <record id="view_mos_silo_form_plus" model="ir.ui.view">
        <field name="name">mos.silo.form.plus</field>
        <field name="model">mos.silo</field>
        <field name="inherit_id" ref="mos_silo.view_mos_silo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Dip reading">
                    <field name="bulk_density"/>
                    <field name="on_hold"/>
                </group>
                <field name="strapping_ids">
                    <list editable="bottom"><field name="height_cm"/><field name="volume_m3"/></list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_mos_silo_dip_list" model="ir.ui.view">
        <field name="name">mos.silo.dip.list</field>
        <field name="model">mos.silo.dip</field>
        <field name="arch" type="xml">
            <list decoration-danger="not within_tolerance" create="1">
                <field name="name"/>
                <field name="silo_id"/>
                <field name="date"/>
                <field name="height_cm"/>
                <field name="measured_kg"/>
                <field name="ledger_kg"/>
                <field name="variance_kg"/>
                <field name="variance_pct"/>
                <field name="adjustment_id"/>
            </list>
        </field>
    </record>
    <record id="view_mos_silo_dip_form" model="ir.ui.view">
        <field name="name">mos.silo.dip.form</field>
        <field name="model">mos.silo.dip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_adjust" string="Draft the adjustment" type="object" class="btn-primary" invisible="within_tolerance or adjustment_id or not name or name == 'New'"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="silo_id" readonly="name != 'New'"/>
                            <field name="date" readonly="name != 'New'"/>
                            <field name="height_cm" readonly="name != 'New'"/>
                            <field name="density" readonly="name != 'New'"/>
                        </group>
                        <group>
                            <field name="volume_m3"/>
                            <field name="measured_kg"/>
                            <field name="ledger_kg"/>
                            <field name="variance_kg"/>
                            <field name="variance_pct"/>
                            <field name="within_tolerance"/>
                            <field name="adjustment_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_silo_dip" model="ir.actions.act_window">
        <field name="name">Silo dip readings</field>
        <field name="res_model">mos.silo.dip</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_mos_silo_hold_list" model="ir.ui.view">
        <field name="name">mos.silo.hold.list</field>
        <field name="model">mos.silo.hold</field>
        <field name="arch" type="xml"><list decoration-warning="state == 'active'"><field name="name"/><field name="silo_id"/><field name="reason"/><field name="chemical"/><field name="started_at"/><field name="planned_end"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_mos_silo_hold_form" model="ir.ui.view">
        <field name="name">mos.silo.hold.form</field>
        <field name="model">mos.silo.hold</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_release" string="Release" type="object" class="btn-primary" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="silo_id"/>
                            <field name="reason"/>
                            <field name="chemical"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="planned_end"/>
                            <field name="released_at"/>
                            <field name="released_by_id"/>
                            <field name="release_note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_silo_hold" model="ir.actions.act_window">
        <field name="name">Silo treatment holds</field>
        <field name="res_model">mos.silo.hold</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_mos_silo_release_wizard" model="ir.ui.view">
        <field name="name">mos.silo.release.wizard.form</field>
        <field name="model">mos.silo.release.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="hold_id" invisible="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Release the silo" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_mos_recipes" name="Recipes" parent="mos_production.menu_mos_production" action="action_mos_recipe" sequence="3"/>
    <menuitem id="menu_mos_work_orders" name="Work orders" parent="mos_production.menu_mos_production" action="action_mos_work_order" sequence="5"/>
    <menuitem id="menu_mos_my_orders" name="My orders today" parent="mos_production.menu_mos_production" action="action_mos_my_orders_today" sequence="6"/>
    <menuitem id="menu_mos_silo_dips" name="Silo dip readings" parent="mos_production.menu_mos_production" action="action_mos_silo_dip" sequence="110"/>
    <menuitem id="menu_mos_silo_holds" name="Silo treatment holds" parent="mos_production.menu_mos_production" action="action_mos_silo_hold" sequence="120"/>
</odoo>
