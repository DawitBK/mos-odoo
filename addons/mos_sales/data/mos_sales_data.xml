<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_delivery_order" model="ir.sequence">
        <field name="name">MOS delivery order</field>
        <field name="code">mos.delivery.order</field>
        <field name="prefix">DO-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_customer_invoice" model="ir.sequence">
        <field name="name">MOS customer invoice</field>
        <field name="code">mos.customer.invoice</field>
        <field name="prefix">CI-%(range_year)s-</field>
        <field name="padding">6</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_receipt" model="ir.sequence">
        <field name="name">MOS receipt</field>
        <field name="code">mos.receipt</field>
        <field name="prefix">RC-%(range_year)s-</field>
        <field name="padding">6</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_cash_session" model="ir.sequence">
        <field name="name">MOS cash session</field>
        <field name="code">mos.cash.session</field>
        <field name="prefix">CS-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
</odoo>
