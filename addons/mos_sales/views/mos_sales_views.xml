<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales order: approval and delivery -->
    <record id="view_sale_order_form_mos" model="ir.ui.view">
        <field name="name">sale.order.form.mos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][not(@id)]" position="before">
                <button name="action_mos_submit_approval" type="object" string="Submit for approval" class="btn-primary"
                        invisible="state not in ('draft', 'sent') or mos_approval_state in ('pending', 'approved')"/>
                <button name="action_mos_recall_approval" type="object" string="Recall approval request" invisible="mos_approval_state != 'pending'"/>
                <button name="action_mos_create_delivery" type="object" string="Prepare delivery" class="btn-primary" invisible="state != 'sale'"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="mos_exposure"/>
                <field name="mos_credit_exceeded" widget="boolean_toggle" readonly="1"/>
                <field name="mos_approval_state" widget="badge" decoration-success="mos_approval_state == 'approved'" decoration-warning="mos_approval_state == 'pending'" decoration-danger="mos_approval_state in ('rejected', 'returned')"/>
            </xpath>
        </field>
    </record>

    <!-- Delivery orders -->
    <record id="view_mos_delivery_order_list" model="ir.ui.view">
        <field name="name">mos.delivery.order.list</field>
        <field name="model">mos.delivery.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="ordered_qty"/>
                <field name="plate"/>
                <field name="loaded_qty"/>
                <field name="state" widget="badge" decoration-success="state == 'dispatched'" decoration-info="state == 'released'"/>
            </list>
        </field>
    </record>
    <record id="view_mos_delivery_order_form" model="ir.ui.view">
        <field name="name">mos.delivery.order.form</field>
        <field name="model">mos.delivery.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_release" string="Release to the gate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_dispatch" string="Dispatch and invoice" type="object" class="btn-primary" invisible="state != 'released'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('dispatched', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,released,dispatched"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="sale_id"/>
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="product_id"/>
                            <field name="ordered_qty"/>
                        </group>
                        <group>
                            <field name="plate" readonly="state != 'draft'"/>
                            <field name="driver_name" readonly="state != 'draft'"/>
                            <field name="visit_id"/>
                            <field name="loaded_qty"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_delivery_order" model="ir.actions.act_window">
        <field name="name">Delivery orders</field>
        <field name="res_model">mos.delivery.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mos_sale_order" model="ir.actions.act_window">
        <field name="name">Sales orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- Customer invoices -->
    <record id="view_mos_customer_invoice_list" model="ir.ui.view">
        <field name="name">mos.customer.invoice.list</field>
        <field name="model">mos.customer.invoice</field>
        <field name="arch" type="xml">
            <list decoration-success="balance &lt;= 0">
                <field name="name"/>
                <field name="date"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="gross_amount" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="fiscal_receipt_ref"/>
            </list>
        </field>
    </record>
    <record id="view_mos_customer_invoice_form" model="ir.ui.view">
        <field name="name">mos.customer.invoice.form</field>
        <field name="model">mos.customer.invoice</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="customer_id" readonly="1"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="delivery_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="fiscal_receipt_ref"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="qty" readonly="1"/>
                            <field name="unit_price" readonly="1"/>
                            <field name="net_amount"/>
                            <field name="vat_amount"/>
                            <field name="gross_amount"/>
                            <field name="paid_amount"/>
                            <field name="balance"/>
                        </group>
                    </group>
                    <field name="receipt_ids"><list><field name="name"/><field name="date"/><field name="method"/><field name="amount"/></list></field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_customer_invoice" model="ir.actions.act_window">
        <field name="name">Customer invoices</field>
        <field name="res_model">mos.customer.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Receipts and cash sessions -->
    <record id="view_mos_receipt_list" model="ir.ui.view">
        <field name="name">mos.receipt.list</field>
        <field name="model">mos.receipt</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="date"/><field name="customer_id"/><field name="invoice_id"/><field name="method"/><field name="amount" sum="Total"/><field name="session_id"/></list>
        </field>
    </record>
    <record id="view_mos_receipt_form" model="ir.ui.view">
        <field name="name">mos.receipt.form</field>
        <field name="model">mos.receipt</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group><field name="customer_id"/><field name="invoice_id"/><field name="amount"/></group>
                        <group><field name="date"/><field name="method"/><field name="reference"/><field name="session_id"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_receipt" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">mos.receipt</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_mos_cash_session_list" model="ir.ui.view">
        <field name="name">mos.cash.session.list</field>
        <field name="model">mos.cash.session</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'open'"><field name="name"/><field name="user_id"/><field name="opened_at"/><field name="expected_cash"/><field name="counted_cash"/><field name="variance"/><field name="state" widget="badge"/></list>
        </field>
    </record>
    <record id="view_mos_cash_session_form" model="ir.ui.view">
        <field name="name">mos.cash.session.form</field>
        <field name="model">mos.cash.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close_form" string="Count and close" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group><field name="user_id"/><field name="opened_at"/><field name="closed_at"/><field name="float_amount" readonly="state != 'open'"/></group>
                        <group>
                            <field name="cash_received"/>
                            <field name="expected_cash"/>
                            <field name="counted_cash" readonly="state != 'open'"/>
                            <field name="variance"/>
                            <field name="variance_reason" readonly="state != 'open'"/>
                        </group>
                    </group>
                    <field name="receipt_ids"><list><field name="name"/><field name="customer_id"/><field name="method"/><field name="amount"/></list></field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_cash_session" model="ir.actions.act_window">
        <field name="name">Cash sessions</field>
        <field name="res_model">mos.cash.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Balances -->
    <record id="view_mos_customer_balance_list" model="ir.ui.view">
        <field name="name">mos.customer.balance.list</field>
        <field name="model">mos.customer.balance</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="customer_id"/>
                <field name="invoiced" sum="Total"/>
                <field name="received" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="current" sum="Total"/>
                <field name="days_31_60" sum="Total"/>
                <field name="days_61_90" sum="Total"/>
                <field name="over_90" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="action_mos_customer_balance" model="ir.actions.act_window">
        <field name="name">Customer balances and ageing</field>
        <field name="res_model">mos.customer.balance</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_mos_sales" name="Sales" parent="mos_core.menu_mos_root" sequence="36"/>
    <menuitem id="menu_mos_sale_orders" name="Sales orders" parent="menu_mos_sales" action="action_mos_sale_order" sequence="10"/>
    <menuitem id="menu_mos_delivery_orders" name="Delivery orders" parent="menu_mos_sales" action="action_mos_delivery_order" sequence="20"/>
    <menuitem id="menu_mos_customer_invoices" name="Customer invoices" parent="menu_mos_sales" action="action_mos_customer_invoice" sequence="30"/>
    <menuitem id="menu_mos_receipts" name="Receipts" parent="menu_mos_sales" action="action_mos_receipt" sequence="40"/>
    <menuitem id="menu_mos_cash_sessions" name="Cash sessions" parent="menu_mos_sales" action="action_mos_cash_session" sequence="50"/>
    <menuitem id="menu_mos_customer_balances" name="Customer balances and ageing" parent="menu_mos_sales" action="action_mos_customer_balance" sequence="60"/>
</odoo>
