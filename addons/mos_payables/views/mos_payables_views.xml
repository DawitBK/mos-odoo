<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Supplier invoices -->
    <record id="view_mos_supplier_invoice_list" model="ir.ui.view">
        <field name="name">mos.supplier.invoice.list</field>
        <field name="model">mos.supplier.invoice</field>
        <field name="arch" type="xml">
            <list decoration-danger="match_state == 'exception'" decoration-muted="state in ('paid', 'cancelled')">
                <field name="name"/>
                <field name="supplier_ref"/>
                <field name="supplier_id"/>
                <field name="invoice_date"/>
                <field name="purchase_id"/>
                <field name="gross_amount" sum="Total"/>
                <field name="payable_amount" sum="Total"/>
                <field name="match_state" widget="badge" decoration-success="match_state == 'matched'" decoration-danger="match_state == 'exception'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_mos_supplier_invoice_form" model="ir.ui.view">
        <field name="name">mos.supplier.invoice.form</field>
        <field name="model">mos.supplier.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_match" string="Match to order and receipt" type="object" class="btn-primary" invisible="state not in ('draft', 'payable')"/>
                    <button name="action_debit_excess" string="Debit the supplier for the excess" type="object" invisible="match_state != 'exception' or state != 'draft'"/>
                    <button name="action_mos_submit_approval" string="Send variance for approval" type="object" invisible="match_state != 'exception' or state != 'draft' or mos_approval_state in ('pending', 'approved')"/>
                    <button name="action_accept_variance" string="Accept approved variance" type="object" invisible="match_state != 'exception' or mos_approval_state != 'approved' or state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('vouchered', 'paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,payable,vouchered,paid"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-receipt"/> Invoice Information</div>
                        <div class="mos-fieldgrid">
                            <div><label for="name" string="Invoice no."/><field name="name"/><div class="text-muted small">(Auto generated)</div></div>
                            <div><label for="invoice_date"/><field name="invoice_date" readonly="state != 'draft'"/></div>
                            <div><label for="supplier_id"/><field name="supplier_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/></div>
                            <div><label for="supplier_ref"/><field name="supplier_ref" readonly="state != 'draft'"/></div>
                            <div><label for="currency_id" string="Currency"/><field name="currency_id" readonly="1"/></div>
                            <div><label for="vat_pct"/><field name="vat_pct" readonly="state != 'draft'"/></div>
                            <div><label for="wht_pct"/><field name="wht_pct" readonly="state != 'draft'"/></div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-clipboard"/> Source Documents</div>
                        <div class="mos-fieldgrid mos-fieldgrid-3">
                            <div><label for="purchase_id"/><field name="purchase_id" readonly="state != 'draft'" options="{'no_create': True}"/></div>
                            <div><label for="grn_numbers" string="Goods receipt(s)"/><field name="grn_numbers"/></div>
                            <div><label for="delivery_note_ref"/><field name="delivery_note_ref" readonly="state not in ('draft', 'payable')"/></div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-cube"/> Invoice Items</div>
                        <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="description"/>
                                <field name="qty"/>
                                <field name="uom_id"/>
                                <field name="unit_price"/>
                                <field name="tax_pct"/>
                                <field name="total_amount"/>
                            </list>
                        </field>
                        <div class="mos-summary-row mos-summary-4">
                            <div><div class="mos-sum-label">Subtotal</div><div class="mos-sum-value"><field name="net_amount"/></div></div>
                            <div><div class="mos-sum-label">VAT</div><div class="mos-sum-value"><field name="vat_amount"/></div></div>
                            <div><div class="mos-sum-label">Withholding</div><div class="mos-sum-value"><field name="wht_amount"/></div></div>
                            <div><div class="mos-sum-label">Total</div><div class="mos-sum-value mos-sum-green"><field name="gross_amount"/></div></div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-scales"/> Three-way Match</div>
                        <field name="match_state" widget="badge" decoration-success="match_state == 'matched'" decoration-danger="match_state == 'exception'" decoration-warning="match_state not in ('matched', 'exception', 'unmatched')"/>
                        <field name="line_ids" nolabel="1" readonly="1" invisible="match_state == 'unmatched'">
                            <list create="0" delete="0" edit="0" decoration-danger="match_state == 'exception'">
                                <field name="product_id"/>
                                <field name="ordered_qty" string="PO quantity"/>
                                <field name="received_qty" string="GRN accepted"/>
                                <field name="qty" string="Invoice quantity"/>
                                <field name="ordered_price" string="PO price"/>
                                <field name="unit_price" string="Invoice price"/>
                                <field name="qty_variance" string="Quantity difference"/>
                                <field name="price_variance_pct" string="Price difference (%)"/>
                                <field name="match_state" widget="badge" decoration-success="match_state == 'matched'" decoration-danger="match_state == 'exception'"/>
                            </list>
                        </field>
                        <field name="debit_note_ids" nolabel="1" invisible="not debit_note_ids">
                            <list><field name="name"/><field name="date"/><field name="amount"/><field name="reason"/></list>
                        </field>
                    </div>
                    <div class="mos-split">
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-money"/> Payment Information</div>
                            <div class="mos-fieldgrid mos-fieldgrid-3">
                                <div><label for="payment_terms_days"/><field name="payment_terms_days" readonly="state not in ('draft', 'payable')"/></div>
                                <div><label for="due_date"/><field name="due_date"/></div>
                                <div><label for="payable_amount" string="Payable to supplier"/><field name="payable_amount"/></div>
                                <div><label for="paid_amount"/><field name="paid_amount"/></div>
                                <div><label for="amount_due"/><field name="amount_due"/></div>
                            </div>
                        </div>
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-shield"/> Approval</div>
                            <div class="mos-fieldgrid mos-fieldgrid-2">
                                <div><label for="mos_approval_state"/><field name="mos_approval_state" widget="badge" decoration-success="mos_approval_state == 'approved'" decoration-warning="mos_approval_state == 'pending'" decoration-danger="mos_approval_state == 'rejected'"/></div>
                                <div><label for="mos_approval_comment" string="Comment"/><field name="mos_approval_comment"/></div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_supplier_invoice" model="ir.actions.act_window">
        <field name="name">Supplier invoices</field>
        <field name="res_model">mos.supplier.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Payment vouchers -->
    <record id="view_mos_payment_voucher_list" model="ir.ui.view">
        <field name="name">mos.payment.voucher.list</field>
        <field name="model">mos.payment.voucher</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('paid', 'cancelled')">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="date"/>
                <field name="gross_amount" sum="Total"/>
                <field name="wht_amount" sum="Total"/>
                <field name="net_amount" sum="Total"/>
                <field name="remaining_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state in ('approved', 'partially_paid')" decoration-warning="state == 'submitted'"/>
            </list>
        </field>
    </record>
    <record id="view_mos_payment_voucher_form" model="ir.ui.view">
        <field name="name">mos.payment.voucher.form</field>
        <field name="model">mos.payment.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="date"/>
                            <field name="mos_approval_state" widget="badge"/>
                        </group>
                        <group>
                            <field name="gross_amount"/>
                            <field name="vat_amount"/>
                            <field name="wht_amount"/>
                            <field name="net_amount"/>
                            <field name="paid_amount"/>
                            <field name="remaining_amount"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="invoice_id"/>
                            <field name="gross"/>
                            <field name="vat"/>
                            <field name="wht"/>
                            <field name="net"/>
                        </list>
                    </field>
                    <field name="payment_ids">
                        <list><field name="name"/><field name="date"/><field name="method"/><field name="cheque_number"/><field name="amount"/></list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_payment_voucher" model="ir.actions.act_window">
        <field name="name">Payment vouchers</field>
        <field name="res_model">mos.payment.voucher</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Payments -->
    <record id="view_mos_payment_list" model="ir.ui.view">
        <field name="name">mos.payment.list</field>
        <field name="model">mos.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="supplier_id"/>
                <field name="voucher_id"/>
                <field name="method"/>
                <field name="cheque_number"/>
                <field name="account_id"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_mos_payment_form" model="ir.ui.view">
        <field name="name">mos.payment.form</field>
        <field name="model">mos.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Make Payment" special="save" class="btn-primary" invisible="id"/>
                    <button string="Cancel" special="cancel" invisible="id"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-bank"/> Payment Information</div>
                        <div class="mos-fieldgrid">
                            <div><label for="name" string="Payment no."/><field name="name"/><div class="text-muted small">(Auto generated)</div></div>
                            <div><label for="date"/><field name="date" readonly="id"/></div>
                            <div><label for="voucher_id" string="Payment request"/><field name="voucher_id" readonly="id" options="{'no_create': True, 'no_open': True}" domain="[('state', 'in', ('approved', 'partially_paid'))]"/></div>
                            <div><label for="supplier_id"/><field name="supplier_id"/></div>
                            <div><label for="currency_id" string="Currency"/><field name="currency_id" readonly="1"/></div>
                            <div><label for="amount" string="Payment amount"/><field name="amount" readonly="1" force_save="1"/></div>
                            <div><label for="amount_in_words"/><field name="amount_in_words"/></div>
                            <div><label for="notes"/><field name="notes" readonly="id" placeholder="Payment against supplier invoice(s)."/></div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-money"/> Payment Methods</div>
                        <p class="mos-section-hint">Select the payment method and provide the required details.</p>
                        <div class="mos-methods">
                            <field name="method" widget="radio" nolabel="1" readonly="id" class="mos-method-rail"/>
                            <div class="mos-method-panel">
                                <div class="mos-fieldgrid">
                                    <div><label for="account_id" string="Paying account"/><field name="account_id" readonly="id" options="{'no_create': True, 'no_open': True}"/></div>
                                    <div invisible="method != 'cheque'"><label for="cheque_book_id"/><field name="cheque_book_id" readonly="id" required="method == 'cheque'" options="{'no_create': True, 'no_open': True}"/></div>
                                    <div invisible="method != 'cheque' or not id"><label for="cheque_number"/><field name="cheque_number"/></div>
                                    <div invisible="method == 'cheque'"><label for="reference" string="Transaction reference"/><field name="reference" readonly="id"/></div>
                                </div>
                                <div id="deposit_slip_area" invisible="method != 'transfer'"/>
                            </div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-clipboard"/> Related Documents</div>
                        <div class="mos-fieldgrid mos-fieldgrid-3">
                            <div><label for="voucher_id" string="Payment request"/><field name="voucher_id" readonly="1"/></div>
                            <div><label for="purchase_refs"/><field name="purchase_refs"/></div>
                            <div><label for="invoice_refs"/><field name="invoice_refs"/></div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-receipt"/> Invoices to be Paid</div>
                        <field name="allocation_ids" nolabel="1" readonly="id">
                            <list editable="bottom" create="false" delete="false">
                                <field name="voucher_line_id" column_invisible="1" force_save="1"/>
                                <field name="previously_paid" column_invisible="1" force_save="1"/>
                                <field name="balance_due" column_invisible="1" force_save="1"/>
                                <field name="include" column_invisible="parent.id"/>
                                <field name="invoice_id"/>
                                <field name="invoice_date"/>
                                <field name="purchase_id"/>
                                <field name="grn_numbers"/>
                                <field name="invoice_amount"/>
                                <field name="previously_paid"/>
                                <field name="balance_due"/>
                                <field name="amount" readonly="not include" force_save="1"/>
                            </list>
                        </field>
                        <div class="mos-summary-row mos-summary-4">
                            <div><div class="mos-sum-label">Total Invoice Amount</div><div class="mos-sum-value"><field name="total_invoice"/></div></div>
                            <div><div class="mos-sum-label">Total Previously Paid</div><div class="mos-sum-value"><field name="total_previous"/></div></div>
                            <div><div class="mos-sum-label">Total Balance Due</div><div class="mos-sum-value mos-sum-red"><field name="total_balance"/></div></div>
                            <div><div class="mos-sum-label">Total Amount to Pay</div><div class="mos-sum-value mos-sum-green"><field name="amount" readonly="1"/></div></div>
                        </div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-shield"/> Approval Information</div>
                        <div class="mos-fieldgrid">
                            <div><label for="approval_by"/><field name="approval_by"/></div>
                            <div><label for="approval_at"/><field name="approval_at"/></div>
                            <div><label for="approval_state"/><field name="approval_state" widget="badge" decoration-success="approval_state == 'approved'"/></div>
                            <div><label for="approval_comment" string="Comments"/><field name="approval_comment"/></div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">mos.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Paying accounts and cheque books -->
    <record id="view_mos_paying_account_list" model="ir.ui.view">
        <field name="name">mos.paying.account.list</field>
        <field name="model">mos.paying.account</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="kind"/><field name="site_id"/><field name="paid_total"/></list></field>
    </record>
    <record id="action_mos_paying_account" model="ir.actions.act_window">
        <field name="name">Paying accounts</field>
        <field name="res_model">mos.paying.account</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_mos_cheque_book_list" model="ir.ui.view">
        <field name="name">mos.cheque.book.list</field>
        <field name="model">mos.cheque.book</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="account_id"/><field name="unused"/><field name="gaps"/></list></field>
    </record>
    <record id="view_mos_cheque_book_form" model="ir.ui.view">
        <field name="name">mos.cheque.book.form</field>
        <field name="model">mos.cheque.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="account_id"/><field name="prefix"/><field name="first_no"/><field name="last_no"/></group>
                        <group><field name="unused"/><field name="gaps"/></group>
                    </group>
                    <field name="leaf_ids">
                        <list create="0" delete="0"><field name="full_number"/><field name="state" widget="badge"/><field name="payment_id"/><field name="void_reason"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_cheque_book" model="ir.actions.act_window">
        <field name="name">Cheque books</field>
        <field name="res_model">mos.cheque.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Balances -->
    <record id="view_mos_supplier_balance_list" model="ir.ui.view">
        <field name="name">mos.supplier.balance.list</field>
        <field name="model">mos.supplier.balance</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="supplier_id"/>
                <field name="invoices"/>
                <field name="billed" sum="Total"/>
                <field name="paid" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="current" sum="Total"/>
                <field name="days_31_60" sum="Total"/>
                <field name="days_61_90" sum="Total"/>
                <field name="over_90" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="action_mos_supplier_balance" model="ir.actions.act_window">
        <field name="name">Supplier balances and ageing</field>
        <field name="res_model">mos.supplier.balance</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_mos_payables" name="Payables" parent="mos_core.menu_mos_root" sequence="35"/>
    <menuitem id="menu_mos_supplier_invoices" name="Supplier invoices" parent="menu_mos_payables" action="action_mos_supplier_invoice" sequence="10"/>
    <menuitem id="menu_mos_payment_vouchers" name="Payment vouchers" parent="menu_mos_payables" action="action_mos_payment_voucher" sequence="20"/>
    <menuitem id="menu_mos_payments" name="Payments" parent="menu_mos_payables" action="action_mos_payment" sequence="30"/>
    <menuitem id="menu_mos_supplier_balance" name="Supplier balances and ageing" parent="menu_mos_payables" action="action_mos_supplier_balance" sequence="40"/>
    <menuitem id="menu_mos_paying_accounts" name="Paying accounts" parent="mos_core.menu_mos_config" action="action_mos_paying_account" sequence="50"/>
    <menuitem id="menu_mos_cheque_books" name="Cheque books" parent="mos_core.menu_mos_config" action="action_mos_cheque_book" sequence="60"/>
</odoo>
