<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_delivery_entry_list" model="ir.ui.view">
        <field name="name">mos.delivery.entry.list</field>
        <field name="model">mos.gate.visit</field>
        <field name="arch" type="xml">
            <list decoration-muted="entry_state == 'rejected'">
                <field name="name"/>
                <field name="delivery_note"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="plate"/>
                <field name="delivery_date"/>
                <field name="arrived_at"/>
                <field name="declared_totals"/>
                <field name="entry_state" widget="badge" decoration-success="entry_state == 'approved'" decoration-danger="entry_state == 'rejected'" decoration-info="entry_state == 'entered'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_mos_delivery_entry_form" model="ir.ui.view">
        <field name="name">mos.delivery.entry.form</field>
        <field name="model">mos.gate.visit</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="entry_state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="purpose" invisible="1"/>
                    <div class="mos-page-head">
                        <span class="mos-page-icon"><i class="mos-ico mos-ico-truck"/></span>
                        <div class="mos-page-title">
                            <h2>Supplier Delivery Entry</h2>
                            <p>Record supplier delivery information before receiving goods</p>
                        </div>
                        <div class="mos-page-crumb">Procurement › Supplier Delivery Entry · <field name="name" class="d-inline"/></div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-doc"/> Delivery Information</div>
                        <group>
                            <group>
                                <field name="partner_id" string="Supplier" required="1" readonly="entry_state != 'entered'" options="{'no_create': True}"/>
                                <field name="purchase_id" string="PO Number" required="1" readonly="entry_state != 'entered'" options="{'no_create': True}"/>
                                <field name="delivery_note" string="Delivery Note Number" required="1" readonly="entry_state != 'entered'"/>
                                <field name="delivery_date" required="1" readonly="entry_state != 'entered'"/>
                            </group>
                            <group>
                                <field name="plate" string="Truck Plate Number" required="1" readonly="entry_state != 'entered'"/>
                                <field name="driver_name" required="1" readonly="entry_state != 'entered'"/>
                                <field name="arrived_at" string="Arrival Date" readonly="entry_state != 'entered'"/>
                                <field name="entry_state" string="Delivery Status" widget="badge" decoration-success="entry_state == 'approved'" decoration-danger="entry_state == 'rejected'" decoration-warning="entry_state == 'entered'"/>
                                <field name="site_id" readonly="entry_state != 'entered'"/>
                                <field name="transporter" readonly="entry_state != 'entered'"/>
                            </group>
                        </group>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-cube"/> Delivered Items</div>
                        <field name="delivery_line_ids" nolabel="1" readonly="entry_state != 'entered'">
                            <list editable="bottom" decoration-danger="over_order">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" string="Item / Material" options="{'no_create': True}"/>
                                <field name="uom_id" string="Unit of Measure" options="{'no_create': True}"/>
                                <field name="declared_qty" string="Preliminary Quantity"/>
                                <field name="bags"/>
                                <field name="ordered_qty"/>
                                <field name="outstanding_qty"/>
                                <field name="over_order" column_invisible="1"/>
                                <field name="note" string="Remarks"/>
                            </list>
                        </field>
                        <div class="mos-note"><i class="mos-ico mos-ico-info"/> You can add multiple items for this delivery. The delivered quantity will be verified during Goods Receiving.</div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-clipboard"/> Summary</div>
                        <div class="mos-summary-row">
                            <div><div class="mos-sum-label">Total Items</div><div class="mos-sum-value"><field name="delivery_item_count"/></div></div>
                            <div><div class="mos-sum-label">Total Preliminary Quantity (one total for each unit)</div><div class="mos-sum-value"><field name="declared_totals"/></div></div>
                            <div><div class="mos-sum-label">Delivery Status</div><div class="mos-sum-value"><field name="entry_state" widget="badge" decoration-success="entry_state == 'approved'" decoration-danger="entry_state == 'rejected'" decoration-warning="entry_state == 'entered'"/></div></div>
                        </div>
                        <group invisible="entry_state != 'rejected'">
                            <field name="entry_reject_reason"/>
                        </group>
                    </div>
                    <div class="mos-action-bar">
                        <button name="action_entry_reject_dialog" string="Reject" type="object" class="btn-danger" invisible="entry_state != 'entered' or purpose != 'inbound_po'"/>
                        <button name="action_entry_approve" string="Approve" type="object" class="btn-primary" invisible="entry_state != 'entered' or purpose != 'inbound_po'"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mos_delivery_reject_form" model="ir.ui.view">
        <field name="name">mos.delivery.reject.form</field>
        <field name="model">mos.delivery.reject</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="visit_id"/>
                    <field name="reason" placeholder="Why is the delivery refused?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject the delivery" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mos_delivery_entry" model="ir.actions.act_window">
        <field name="name">Supplier deliveries</field>
        <field name="res_model">mos.gate.visit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('purpose', '=', 'inbound_po')]</field>
        <field name="context">{'default_purpose': 'inbound_po'}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_mos_delivery_entry_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_mos_delivery_entry_form')})]"/>
    </record>
    <menuitem id="menu_mos_delivery_entry" name="Supplier deliveries" parent="mos_gate.menu_mos_gate" action="action_mos_delivery_entry" sequence="5"/>
</odoo>
