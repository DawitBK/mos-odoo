<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The roles an approval matrix row can name. A person holds the role by being in the group. -->
    <record id="group_mos_dept_manager" model="res.groups">
        <field name="name">Department manager</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="mos_core.res_groups_privilege_mos"/>
        <field name="implied_ids" eval="[(4, ref('mos_core.group_mos_user'))]"/>
    </record>
    <record id="group_mos_finance_manager" model="res.groups">
        <field name="name">Finance manager</field>
        <field name="sequence">61</field>
        <field name="privilege_id" ref="mos_core.res_groups_privilege_mos"/>
        <field name="implied_ids" eval="[(4, ref('mos_core.group_mos_user'))]"/>
    </record>
    <record id="group_mos_general_manager" model="res.groups">
        <field name="name">General manager</field>
        <field name="sequence">62</field>
        <field name="privilege_id" ref="mos_core.res_groups_privilege_mos"/>
        <field name="implied_ids" eval="[(4, ref('mos_core.group_mos_user'))]"/>
    </record>
</odoo>
