<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_mos_sales_manager" model="res.groups">
        <field name="name">Sales manager</field>
        <field name="sequence">82</field>
        <field name="privilege_id" ref="mos_core.res_groups_privilege_mos"/>
        <field name="implied_ids" eval="[(4, ref('mos_sales.group_mos_sales_rep')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <!-- Registering a customer is part of a sales representative's day; approval is the control. -->
    <record id="mos_sales.group_mos_sales_rep" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base.group_partner_manager'))]"/>
    </record>
</odoo>
