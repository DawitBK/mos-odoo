<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_credit_note" model="ir.sequence">
        <field name="name">MOS customer credit note</field>
        <field name="code">mos.credit.note</field>
        <field name="prefix">CN-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_credit_change" model="ir.sequence">
        <field name="name">MOS credit limit change</field>
        <field name="code">mos.credit.change</field>
        <field name="prefix">CL-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_customer_return" model="ir.sequence">
        <field name="name">MOS customer return</field>
        <field name="code">mos.customer.return</field>
        <field name="prefix">CR-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
    </record>
</odoo>
