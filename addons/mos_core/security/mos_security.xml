<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mos" model="res.groups.privilege">
        <field name="name">MOS</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_mos_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mos"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mos_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mos"/>
        <field name="implied_ids" eval="[(4, ref('group_mos_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
