<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_site_list" model="ir.ui.view">
        <field name="name">mos.site.list</field>
        <field name="model">mos.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="tz"/>
            </list>
        </field>
    </record>
    <record id="view_mos_site_form" model="ir.ui.view">
        <field name="name">mos.site.form</field>
        <field name="model">mos.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="tz"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="user_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">mos.site</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mos_reason_list" model="ir.ui.view">
        <field name="name">mos.reason.list</field>
        <field name="model">mos.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="domain"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_mos_reason" model="ir.actions.act_window">
        <field name="name">Reason codes</field>
        <field name="res_model">mos.reason</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_mos_audit_list" model="ir.ui.view">
        <field name="name">mos.audit.event.list</field>
        <field name="model">mos.audit.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="id"/>
                <field name="occurred_at"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="summary"/>
            </list>
        </field>
    </record>
    <record id="action_mos_audit" model="ir.actions.act_window">
        <field name="name">Audit log</field>
        <field name="res_model">mos.audit.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
