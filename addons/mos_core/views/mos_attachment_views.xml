<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_attachment_list" model="ir.ui.view">
        <field name="name">mos.attachment.list</field>
        <field name="model">mos.attachment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="size"/>
                <field name="sha256" optional="hide"/>
                <field name="scan_state" widget="badge"/>
                <field name="uploaded_by_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_mos_attachment_form" model="ir.ui.view">
        <field name="name">mos.attachment.form</field>
        <field name="model">mos.attachment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="id"/>
                            <field name="file" filename="name" readonly="id"/>
                            <field name="res_model" readonly="id"/>
                            <field name="res_id" readonly="id"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="size"/>
                            <field name="mimetype"/>
                            <field name="sha256"/>
                            <field name="scan_state"/>
                            <field name="uploaded_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_attachment" model="ir.actions.act_window">
        <field name="name">Attached files</field>
        <field name="res_model">mos.attachment</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_mos_attachments" name="Attached files" parent="menu_mos_config" action="action_mos_attachment" sequence="40"/>
</odoo>
