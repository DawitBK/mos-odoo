<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="location_mos_transit" model="stock.location">
        <field name="name">MOS in transit</field>
        <field name="usage">transit</field>
        <field name="company_id"></field>
    </record>
    <record id="seq_transfer_order" model="ir.sequence">
        <field name="name">MOS transfer between sites</field>
        <field name="code">mos.transfer.order</field>
        <field name="prefix">TRF-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="cron_transfer_late" model="ir.cron">
        <field name="name">MOS: flag transfers in transit too long</field>
        <field name="model_id" ref="model_mos_transfer_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_late()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
