<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everything the record keeps is shown on its screen: the fields below were stored and used by the rules but appeared on no form. -->
    <record id="view_mos_batch_parity" model="ir.ui.view">
        <field name="name">mos.batch.form.parity</field>
        <field name="model">mos.batch</field>
        <field name="inherit_id" ref="view_mos_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="mos-section">
                    <div class="mos-section-title"><i class="mos-ico mos-ico-doc"/> More details</div>
                    <div class="mos-fieldgrid mos-fieldgrid-2">
                        <div><label for="uom_id"/><field name="uom_id" readonly="1"/></div>
                    </div>
                </div>
                <div class="mos-section">
                    <div class="mos-section-title"><i class="mos-ico mos-ico-list"/> Related records</div>
                    <div><label for="child_link_ids"/>
                    <field name="child_link_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="child_id"/>
                            <field name="qty"/>
                        </list>
                    </field></div>
                    <div><label for="inspection_ids"/>
                    <field name="inspection_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="spec_id"/>
                            <field name="state" widget="badge"/>
                            <field name="suggested"/>
                            <field name="tested_by_id"/>
                        </list>
                    </field></div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_mos_batch_inspection_parity" model="ir.ui.view">
        <field name="name">mos.batch.inspection.form.parity</field>
        <field name="model">mos.batch.inspection</field>
        <field name="inherit_id" ref="view_mos_batch_inspection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="mos-section">
                    <div class="mos-section-title"><i class="mos-ico mos-ico-doc"/> More details</div>
                    <div class="mos-fieldgrid mos-fieldgrid-2">
                        <div><label for="tested_by_id"/><field name="tested_by_id" readonly="1"/></div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
