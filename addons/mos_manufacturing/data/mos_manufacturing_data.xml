<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_batch" model="ir.sequence">
        <field name="name">MOS batch</field>
        <field name="code">mos.batch</field>
        <field name="prefix">B-%(range_year)s-</field>
        <field name="padding">6</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_pack_run" model="ir.sequence">
        <field name="name">MOS packing run</field>
        <field name="code">mos.pack.run</field>
        <field name="prefix">PK-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_batch_inspection" model="ir.sequence">
        <field name="name">MOS finished-goods inspection</field>
        <field name="code">mos.batch.inspection</field>
        <field name="prefix">FQ-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
</odoo>
