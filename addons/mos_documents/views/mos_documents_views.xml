<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The attached-files screens know the kind of document and its verification -->
    <record id="view_mos_attachment_list_documents" model="ir.ui.view">
        <field name="name">mos.attachment.list.documents</field>
        <field name="model">mos.attachment</field>
        <field name="inherit_id" ref="mos_core.view_mos_attachment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="kind"/>
            </xpath>
            <xpath expr="//field[@name='scan_state']" position="after">
                <field name="verify_state" widget="badge" decoration-success="verify_state == 'verified'" decoration-warning="verify_state == 'unverified'"/>
            </xpath>
        </field>
    </record>
    <record id="view_mos_attachment_form_documents" model="ir.ui.view">
        <field name="name">mos.attachment.form.documents</field>
        <field name="model">mos.attachment</field>
        <field name="inherit_id" ref="mos_core.view_mos_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_verify" string="Verify" type="object" class="btn-primary" invisible="verify_state == 'verified' or not id"/>
                    <field name="verify_state" widget="statusbar"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='note']" position="before">
                <field name="kind"/>
            </xpath>
            <xpath expr="//field[@name='uploaded_by_id']" position="after">
                <field name="verified_by_id" invisible="verify_state != 'verified'"/>
                <field name="verified_at" invisible="verify_state != 'verified'"/>
            </xpath>
        </field>
    </record>

    <!-- The panel of attached documents at the foot of a document -->
    <record id="view_mos_purchase_order_form_documents" model="ir.ui.view">
        <field name="name">purchase.order.form.documents</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attached documents" name="mos_documents">
                    <field name="mos_attachment_ids" context="{'default_res_model': 'purchase.order'}" nolabel="1">
                        <list editable="bottom">
                            <field name="kind"/>
                            <field name="file" filename="name" readonly="id"/>
                            <field name="name" column_invisible="1"/>
                            <field name="note"/>
                            <field name="verify_state" widget="badge" decoration-success="verify_state == 'verified'" decoration-warning="verify_state == 'unverified'"/>
                            <field name="uploaded_by_id" widget="many2one_avatar_user"/>
                            <button name="action_verify" type="object" string="Verify" icon="fa-check" invisible="verify_state == 'verified' or not id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_mos_purchase_request_form_documents" model="ir.ui.view">
        <field name="name">mos.purchase.request.form.documents</field>
        <field name="model">mos.purchase.request</field>
        <field name="inherit_id" ref="mos_procurement.view_mos_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <separator string="Attached documents"/>
                <field name="mos_attachment_ids" context="{'default_res_model': 'mos.purchase.request', 'default_kind': 'specification'}" nolabel="1">
                    <list editable="bottom">
                        <field name="kind"/>
                        <field name="file" filename="name" readonly="id"/>
                        <field name="name" column_invisible="1"/>
                        <field name="note"/>
                        <field name="verify_state" widget="badge" decoration-success="verify_state == 'verified'" decoration-warning="verify_state == 'unverified'"/>
                        <field name="uploaded_by_id" widget="many2one_avatar_user"/>
                        <button name="action_verify" type="object" string="Verify" icon="fa-check" invisible="verify_state == 'verified' or not id"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_mos_gate_visit_form_documents" model="ir.ui.view">
        <field name="name">mos.gate.visit.form.documents</field>
        <field name="model">mos.gate.visit</field>
        <field name="inherit_id" ref="mos_gate.view_mos_gate_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <separator string="Attached documents"/>
                <field name="mos_attachment_ids" context="{'default_res_model': 'mos.gate.visit', 'default_kind': 'delivery_note'}" nolabel="1">
                    <list editable="bottom">
                        <field name="kind"/>
                        <field name="file" filename="name" readonly="id"/>
                        <field name="name" column_invisible="1"/>
                        <field name="note"/>
                        <field name="verify_state" widget="badge" decoration-success="verify_state == 'verified'" decoration-warning="verify_state == 'unverified'"/>
                        <field name="uploaded_by_id" widget="many2one_avatar_user"/>
                        <button name="action_verify" type="object" string="Verify" icon="fa-check" invisible="verify_state == 'verified' or not id"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_mos_payment_voucher_form_documents" model="ir.ui.view">
        <field name="name">mos.payment.voucher.form.documents</field>
        <field name="model">mos.payment.voucher</field>
        <field name="inherit_id" ref="mos_payables.view_mos_payment_voucher_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <separator string="Attached documents"/>
                <field name="mos_attachment_ids" context="{'default_res_model': 'mos.payment.voucher', 'default_kind': 'deposit_slip'}" nolabel="1">
                    <list editable="bottom">
                        <field name="kind"/>
                        <field name="file" filename="name" readonly="id"/>
                        <field name="name" column_invisible="1"/>
                        <field name="note"/>
                        <field name="verify_state" widget="badge" decoration-success="verify_state == 'verified'" decoration-warning="verify_state == 'unverified'"/>
                        <field name="uploaded_by_id" widget="many2one_avatar_user"/>
                        <button name="action_verify" type="object" string="Verify" icon="fa-check" invisible="verify_state == 'verified' or not id"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_mos_supplier_invoice_form_documents" model="ir.ui.view">
        <field name="name">mos.supplier.invoice.form.documents</field>
        <field name="model">mos.supplier.invoice</field>
        <field name="inherit_id" ref="mos_payables.view_mos_supplier_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_accept_variance']" position="after">
                <field name="approval_gate" invisible="1"/>
                <button name="action_mos_submit_approval" string="Send for approval" type="object" class="btn-primary" invisible="not approval_gate"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <separator string="Attached documents"/>
                <field name="mos_attachment_ids" context="{'default_res_model': 'mos.supplier.invoice', 'default_kind': 'supplier_invoice'}" nolabel="1">
                    <list editable="bottom">
                        <field name="kind"/>
                        <field name="file" filename="name" readonly="id"/>
                        <field name="name" column_invisible="1"/>
                        <field name="note"/>
                        <field name="verify_state" widget="badge" decoration-success="verify_state == 'verified'" decoration-warning="verify_state == 'unverified'"/>
                        <field name="uploaded_by_id" widget="many2one_avatar_user"/>
                        <button name="action_verify" type="object" string="Verify" icon="fa-check" invisible="verify_state == 'verified' or not id"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
