<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_supplier_submission_list" model="ir.ui.view">
        <field name="name">mos.supplier.submission.list</field>
        <field name="model">mos.supplier.submission</field>
        <field name="arch" type="xml"><list create="0" decoration-muted="state != 'new'"><field name="name"/><field name="supplier_id"/><field name="supplier_ref"/><field name="order_id"/><field name="amount"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_mos_supplier_submission_form" model="ir.ui.view">
        <field name="name">mos.supplier.submission.form</field>
        <field name="model">mos.supplier.submission</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_review" string="Mark as entered" type="object" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'new'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,reviewed"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group><field name="supplier_id"/><field name="supplier_ref"/><field name="order_id"/><field name="amount"/></group>
                        <group><field name="reviewed_by_id"/><field name="invoice_id"/><field name="review_note" readonly="state != 'new'" placeholder="Reason, if you reject it"/></group>
                    </group>
                    <field name="attachment_ids" readonly="1"><list><field name="name"/><field name="size"/><field name="sha256"/><field name="scan_state"/></list></field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_supplier_submission" model="ir.actions.act_window">
        <field name="name">Invoices sent by suppliers</field>
        <field name="res_model">mos.supplier.submission</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_mos_supplier_submission" name="Invoices sent by suppliers" parent="mos_payables.menu_mos_payables" action="action_mos_supplier_submission" sequence="60"/>

    <record id="view_partner_form_portal_invite" model="ir.ui.view">
        <field name="name">res.partner.form.portal.invite</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header invisible="supplier_rank == 0">
                    <button name="action_mos_portal_invite" string="Invite to the supplier portal" type="object" groups="mos_procurement.group_mos_procurement_manager,mos_core.group_mos_admin"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
