<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This database belongs to a flour mill, not to "My Company". -->
    <record id="base.main_company" model="res.company">
        <field name="name">Example Flour Mill</field>
    </record>

    <!-- The server action creates a fresh overview each time and opens it, so the figures are always current. -->
    <record id="action_mos_overview" model="ir.actions.server">
        <field name="name">Overview</field>
        <field name="model_id" ref="model_mos_overview"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
