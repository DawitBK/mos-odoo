<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_gate_incident" model="ir.sequence">
        <field name="name">MOS gate incident</field>
        <field name="code">mos.gate.incident</field>
        <field name="prefix">INC-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
    </record>
    <record id="seq_gate_pass" model="ir.sequence">
        <field name="name">MOS material gate pass</field>
        <field name="code">mos.gate.pass</field>
        <field name="prefix">GP-%(range_year)s-</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
    </record>
</odoo>
