<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_gate_visit_list" model="ir.ui.view">
        <field name="name">mos.gate.visit.list</field>
        <field name="model">mos.gate.visit</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('exited', 'cancelled')" decoration-info="state == 'arrived'">
                <field name="name"/>
                <field name="plate"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="site_id"/>
                <field name="net_weight"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_mos_gate_visit_form" model="ir.ui.view">
        <field name="name">mos.gate.visit.form</field>
        <field name="model">mos.gate.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_weighing" string="Start weighing" type="object" class="btn-primary" invisible="state != 'arrived'"/>
                    <button name="action_clear_exit" string="Clear exit" type="object" class="btn-primary" invisible="state != 'weighed'"/>
                    <button name="action_exit" string="Record exit" type="object" invisible="state != 'cleared'"/>
                    <button name="action_cancel" string="Cancel visit" type="object" invisible="state in ('exited', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="arrived,weighing,weighed,cleared,exited"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="plate"/>
                            <field name="driver_name"/>
                            <field name="transporter"/>
                        </group>
                        <group>
                            <field name="purpose"/>
                            <field name="partner_id"/>
                            <field name="purchase_id"/>
                            <field name="net_weight"/>
                        </group>
                    </group>
                    <field name="ticket_ids">
                        <list>
                            <field name="name"/>
                            <field name="first_weight"/>
                            <field name="second_weight"/>
                            <field name="net_weight"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_gate_visit" model="ir.actions.act_window">
        <field name="name">Gate visits</field>
        <field name="res_model">mos.gate.visit</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_mos_weigh_ticket_list" model="ir.ui.view">
        <field name="name">mos.weigh.ticket.list</field>
        <field name="model">mos.weigh.ticket</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="visit_id"/>
                <field name="first_weight"/>
                <field name="second_weight"/>
                <field name="net_weight"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_mos_weigh_ticket" model="ir.actions.act_window">
        <field name="name">Weigh tickets</field>
        <field name="res_model">mos.weigh.ticket</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_mos_gate" name="Gate" parent="mos_core.menu_mos_root" sequence="10"/>
    <menuitem id="menu_mos_gate_visits" name="Visits" parent="menu_mos_gate" action="action_mos_gate_visit" sequence="10"/>
    <menuitem id="menu_mos_weigh_tickets" name="Weigh tickets" parent="menu_mos_gate" action="action_mos_weigh_ticket" sequence="20"/>
</odoo>
