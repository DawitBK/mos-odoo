<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Visit form additions -->
    <record id="view_mos_gate_visit_form_plus" model="ir.ui.view">
        <field name="name">mos.gate.visit.form.plus</field>
        <field name="model">mos.gate.visit</field>
        <field name="inherit_id" ref="mos_gate.view_mos_gate_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_gate_ui" string="Override clearance" type="object" context="{'mos_method': 'action_override_clearance', 'mos_title': 'Override a clearance check'}" invisible="state not in ('weighed', 'cleared') or clearance_override_by_id"/>
                <button name="action_gate_ui" string="Approve weight" type="object" context="{'mos_method': 'action_approve_tolerance', 'mos_title': 'Approve a weight outside the tolerance'}" invisible="not tolerance_blocked"/>
            </xpath>
            <xpath expr="//field[@name='transporter']" position="after">
                <field name="trailer_plate"/>
                <field name="driver_license"/>
                <field name="driver_phone"/>
                <field name="gate_post_id"/>
                <field name="weighbridge_id"/>
            </xpath>
            <xpath expr="//field[@name='purchase_id']" position="after">
                <field name="reference_doc"/>
                <field name="seal_number"/>
                <field name="seal_intact"/>
                <field name="persons_count" invisible="purpose != 'service'"/>
                <field name="work_permit_ref" invisible="purpose != 'service'"/>
            </xpath>
            <xpath expr="//field[@name='ticket_ids']" position="before">
                <field name="tool_ids" invisible="purpose != 'service'">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="qty_in"/>
                        <field name="qty_out"/>
                        <field name="explanation"/>
                    </list>
                </field>
                <field name="clearance_ids" readonly="1">
                    <list>
                        <field name="at"/>
                        <field name="user_id"/>
                        <field name="result" widget="badge"/>
                        <field name="reasons"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- Posts and weighbridges -->
    <record id="view_mos_gate_post_list" model="ir.ui.view">
        <field name="name">mos.gate.post.list</field>
        <field name="model">mos.gate.post</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="site_id"/><field name="direction"/><field name="allows"/></list></field>
    </record>
    <record id="action_mos_gate_post" model="ir.actions.act_window">
        <field name="name">Gate posts</field>
        <field name="res_model">mos.gate.post</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_mos_weighbridge_list" model="ir.ui.view">
        <field name="name">mos.weighbridge.list</field>
        <field name="model">mos.weighbridge</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="post_id"/><field name="capacity_kg"/><field name="division_kg"/></list></field>
    </record>
    <record id="action_mos_weighbridge" model="ir.actions.act_window">
        <field name="name">Weighbridges</field>
        <field name="res_model">mos.weighbridge</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Tolerances -->
    <record id="view_mos_gate_tolerance_list" model="ir.ui.view">
        <field name="name">mos.gate.tolerance.list</field>
        <field name="model">mos.gate.tolerance</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="site_id"/><field name="purpose"/><field name="categ_id"/><field name="product_id"/><field name="partner_id"/><field name="pct"/><field name="action"/></list></field>
    </record>
    <record id="action_mos_gate_tolerance" model="ir.actions.act_window">
        <field name="name">Weight tolerances</field>
        <field name="res_model">mos.gate.tolerance</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Paper mode -->
    <record id="view_mos_paper_book_list" model="ir.ui.view">
        <field name="name">mos.paper.book.list</field>
        <field name="model">mos.paper.book</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="first_no"/><field name="last_no"/><field name="open_count"/><field name="used_count"/></list></field>
    </record>
    <record id="view_mos_paper_book_form" model="ir.ui.view">
        <field name="name">mos.paper.book.form</field>
        <field name="model">mos.paper.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="site_id"/><field name="prefix"/></group>
                        <group><field name="first_no"/><field name="last_no"/></group>
                    </group>
                    <field name="slip_ids" readonly="1">
                        <list><field name="code"/><field name="state" widget="badge"/><field name="plate"/><field name="visit_id"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_paper_book" model="ir.actions.act_window">
        <field name="name">Paper slip books</field>
        <field name="res_model">mos.paper.book</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_mos_paper_slip_list" model="ir.ui.view">
        <field name="name">mos.paper.slip.list</field>
        <field name="model">mos.paper.slip</field>
        <field name="arch" type="xml"><list decoration-muted="state == 'void'"><field name="code"/><field name="plate"/><field name="arrived_at"/><field name="exited_at"/><field name="state" widget="badge"/><field name="visit_id"/></list></field>
    </record>
    <record id="view_mos_paper_slip_form" model="ir.ui.view">
        <field name="name">mos.paper.slip.form</field>
        <field name="model">mos.paper.slip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enter" string="Enter into the system" type="object" class="btn-primary" invisible="state != 'issued'"/>
                    <button name="action_gate_ui" string="Void" type="object" context="{'mos_method': 'action_void', 'mos_title': 'Void the slip'}" invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="code"/></h1>
                    <group>
                        <group>
                            <field name="plate" readonly="state != 'issued'"/>
                            <field name="driver_name" readonly="state != 'issued'"/>
                            <field name="purpose" readonly="state != 'issued'"/>
                            <field name="purchase_id" readonly="state != 'issued'"/>
                        </group>
                        <group>
                            <field name="arrived_at" readonly="state != 'issued'"/>
                            <field name="exited_at" readonly="state != 'issued'"/>
                            <field name="gross_kg" readonly="state != 'issued'"/>
                            <field name="tare_kg" readonly="state != 'issued'"/>
                            <field name="visit_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mos_paper_slip" model="ir.actions.act_window">
        <field name="name">Back-entry of paper slips</field>
        <field name="res_model">mos.paper.slip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_issued': 1}</field>
    </record>
    <record id="view_mos_paper_slip_search" model="ir.ui.view">
        <field name="name">mos.paper.slip.search</field>
        <field name="model">mos.paper.slip</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="plate"/>
                <filter name="issued" string="Not yet entered" domain="[('state', '=', 'issued')]"/>
            </search>
        </field>
    </record>

    <!-- Arrival by plate, register -->
    <record id="view_mos_gate_arrival_form" model="ir.ui.view">
        <field name="name">mos.gate.arrival.form</field>
        <field name="model">mos.gate.arrival</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="site_id"/>
                        <field name="gate_post_id"/>
                        <field name="plate" placeholder="Type or scan the plate"/>
                        <field name="purpose"/>
                    </group>
                    <group>
                        <field name="driver_name"/>
                        <field name="reference_doc"/>
                    </group>
                </group>
                <footer>
                    <button name="action_arrive" string="Register the arrival" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mos_gate_arrival" model="ir.actions.act_window">
        <field name="name">Register an arrival</field>
        <field name="res_model">mos.gate.arrival</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_mos_gate_register_form" model="ir.ui.view">
        <field name="name">mos.gate.register.form</field>
        <field name="model">mos.gate.register</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group><field name="site_id"/><field name="date"/></group>
                    <group><field name="visits"/><field name="net_total"/><field name="superseded"/></group>
                </group>
                <button name="action_print" string="Print the register" type="object" class="btn-primary"/>
                <field name="visit_ids" readonly="1">
                    <list><field name="name"/><field name="plate"/><field name="purpose"/><field name="partner_id"/><field name="arrived_at"/><field name="exited_at"/><field name="state" widget="badge"/></list>
                </field>
                <field name="ticket_ids" readonly="1">
                    <list decoration-muted="state == 'superseded'"><field name="name"/><field name="visit_id"/><field name="gross_weight"/><field name="tare_weight"/><field name="net_weight"/><field name="state" widget="badge"/></list>
                </field>
            </form>
        </field>
    </record>
    <record id="action_mos_gate_register" model="ir.actions.act_window">
        <field name="name">Daily gate register</field>
        <field name="res_model">mos.gate.register</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <record id="view_mos_gate_action_wizard" model="ir.ui.view">
        <field name="name">mos.gate.action.wizard.form</field>
        <field name="model">mos.gate.action.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="method" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_mos_gate_arrival" name="Register an arrival" parent="mos_gate.menu_mos_gate" action="action_mos_gate_arrival" sequence="3"/>
    <menuitem id="menu_mos_gate_register" name="Daily gate register" parent="mos_gate.menu_mos_gate" action="action_mos_gate_register" sequence="65"/>
    <menuitem id="menu_mos_paper_slips" name="Back-entry of paper slips" parent="mos_gate.menu_mos_gate" action="action_mos_paper_slip" sequence="70"/>
    <menuitem id="menu_mos_gate_posts" name="Gate posts" parent="mos_gate.menu_mos_gate_config" action="action_mos_gate_post" sequence="30"/>
    <menuitem id="menu_mos_weighbridges" name="Weighbridges" parent="mos_gate.menu_mos_gate_config" action="action_mos_weighbridge" sequence="40"/>
    <menuitem id="menu_mos_gate_tolerances" name="Weight tolerances" parent="mos_gate.menu_mos_gate_config" action="action_mos_gate_tolerance" sequence="50"/>
    <menuitem id="menu_mos_paper_books" name="Paper slip books" parent="mos_gate.menu_mos_gate_config" action="action_mos_paper_book" sequence="60"/>
</odoo>
