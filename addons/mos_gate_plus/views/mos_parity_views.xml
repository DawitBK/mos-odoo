<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everything the record keeps is shown on its screen: the fields below were stored and used by the rules but appeared on no form. -->
    <record id="view_mos_paper_slip_parity" model="ir.ui.view">
        <field name="name">mos.paper.slip.form.parity</field>
        <field name="model">mos.paper.slip</field>
        <field name="inherit_id" ref="view_mos_paper_slip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="mos-section">
                    <div class="mos-section-title"><i class="mos-ico mos-ico-doc"/> More details</div>
                    <div class="mos-fieldgrid mos-fieldgrid-2">
                        <div><label for="number"/><field name="number" readonly="1"/></div>
                        <div><label for="void_reason"/><field name="void_reason" readonly="1"/></div>
                        <div><label for="entered_by_id"/><field name="entered_by_id" readonly="1"/></div>
                        <div><label for="entered_at"/><field name="entered_at" readonly="1"/></div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
