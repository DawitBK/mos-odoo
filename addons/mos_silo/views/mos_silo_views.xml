<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_silo_list" model="ir.ui.view">
        <field name="name">mos.silo.list</field>
        <field name="model">mos.silo</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'full'" decoration-warning="status in ('high', 'low')" decoration-muted="status == 'empty'">
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="level_kg" sum="Total"/>
                <field name="capacity_kg" sum="Total"/>
                <field name="fill_pct" widget="progressbar"/>
                <field name="status" widget="badge" decoration-success="status == 'ok'" decoration-warning="status in ('low', 'high')" decoration-danger="status == 'full'"/>
            </list>
        </field>
    </record>
    <record id="view_mos_silo_form" model="ir.ui.view">
        <field name="name">mos.silo.form</field>
        <field name="model">mos.silo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="mos-page-head">
                        <span class="mos-page-icon"><i class="mos-ico mos-ico-sack"/></span>
                        <div class="mos-page-title"><h2>Silo Master</h2><p>Define a storage silo: what it holds, how much, and the levels that guard it</p></div>
                        <div class="mos-page-crumb">Inventory › Silo Master</div>
                    </div>
                    <div class="mos-split">
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-doc"/> Basic Information</div>
                            <div class="mos-fieldgrid mos-fieldgrid-2">
                                <div><label for="code" string="Silo code"/><field name="code"/></div>
                                <div><label for="name" string="Silo name"/><field name="name"/></div>
                                <div><label for="silo_type"/><field name="silo_type"/></div>
                                <div><label for="product_id" string="Grain"/><field name="product_id" options="{'no_create': True}"/></div>
                                <div><label for="site_id" string="Operation unit"/><field name="site_id" options="{'no_create': True}"/></div>
                                <div><label for="warehouse_id"/><field name="warehouse_id"/></div>
                                <div class="mos-fieldgrid-wide"><label for="description"/><field name="description"/></div>
                            </div>
                        </div>
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-cube"/> Capacity</div>
                            <div class="mos-fieldgrid mos-fieldgrid-2">
                                <div><label for="capacity_kg" string="Maximum capacity (kg)"/><field name="capacity_kg"/></div>
                                <div><label for="level_kg" string="Current level (kg, from the stock ledger)"/><field name="level_kg"/></div>
                                <div><label for="free_kg"/><field name="free_kg"/></div>
                                <div><label for="status" string="Silo status"/><field name="status" widget="badge" decoration-success="status == 'ok'" decoration-warning="status in ('low', 'high')" decoration-danger="status == 'full'"/></div>
                                <div class="mos-fieldgrid-wide"><label for="fill_pct" string="Filled"/><field name="fill_pct" widget="progressbar"/></div>
                            </div>
                        </div>
                    </div>
                    <div class="mos-split">
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-scales"/> Parameters</div>
                            <div class="mos-fieldgrid mos-fieldgrid-3">
                                <div><label for="min_level_kg"/><field name="min_level_kg"/></div>
                                <div><label for="max_level_kg"/><field name="max_level_kg"/></div>
                                <div><label for="safety_stock_kg"/><field name="safety_stock_kg"/></div>
                            </div>
                            <div class="mos-note"><i class="mos-ico mos-ico-info"/> A load that would take the silo above its maximum is refused; a milling run cannot draw it below its safety stock; below the minimum it shows as low.</div>
                        </div>
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-check"/> Status</div>
                            <div class="mos-fieldgrid">
                                <div><label for="active" string="Active"/><field name="active" widget="boolean_toggle"/></div>
                                <div><label for="location_id" string="Stock location"/><field name="location_id"/></div>
                            </div>
                            <div class="mos-action-row">
                                <button name="action_open_stock" type="object" class="btn btn-secondary" string="Stock in this silo"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mos_silo_kanban" model="ir.ui.view">
        <field name="name">mos.silo.kanban</field>
        <field name="model">mos.silo</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong class="fs-4"><field name="code"/></strong>
                            <field name="status" widget="badge" decoration-success="status == 'ok'" decoration-warning="status in ('low', 'high')" decoration-danger="status == 'full'"/>
                        </div>
                        <div class="text-muted"><field name="name"/> · <field name="product_id"/></div>
                        <field name="fill_pct" widget="progressbar" class="mt-2"/>
                        <div class="mt-1"><field name="level_kg"/> kg of <field name="capacity_kg"/> kg</div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_mos_silo" model="ir.actions.act_window">
        <field name="name">Silos</field>
        <field name="res_model">mos.silo</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <menuitem id="menu_mos_stock" name="Silos &amp; Stock" parent="mos_core.menu_mos_root" sequence="30"/>
    <menuitem id="menu_mos_silos" name="Silos" parent="menu_mos_stock" action="action_mos_silo" sequence="10"/>
</odoo>
