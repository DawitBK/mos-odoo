<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mos_milling_run_list" model="ir.ui.view">
        <field name="name">mos.milling.run.list</field>
        <field name="model">mos.milling.run</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="run_date"/>
                <field name="shift"/>
                <field name="site_id"/>
                <field name="wheat_kg" sum="Total"/>
                <field name="flour_kg" sum="Total"/>
                <field name="bran_kg" sum="Total"/>
                <field name="extraction_pct" avg="Average"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_mos_milling_run_form" model="ir.ui.view">
        <field name="name">mos.milling.run.form</field>
        <field name="model">mos.milling.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete" string="Complete run" type="object" class="btn-primary" invisible="state != 'draft'"
                            confirm="Complete the run? Wheat leaves the silos and the flour is booked into stock. This cannot be undone."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="run_date"/>
                            <field name="shift"/>
                        </group>
                        <group>
                            <field name="wheat_kg"/>
                            <field name="flour_kg"/>
                            <field name="bran_kg"/>
                            <field name="loss_kg"/>
                            <field name="extraction_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Wheat drawn from silos">
                            <field name="input_ids">
                                <list editable="bottom">
                                    <field name="silo_id"/>
                                    <field name="product_id"/>
                                    <field name="qty_kg" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Flour and by-products">
                            <field name="output_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="kind"/>
                                    <field name="qty_kg" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_mos_milling_run_graph" model="ir.ui.view">
        <field name="name">mos.milling.run.graph</field>
        <field name="model">mos.milling.run</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="run_date" interval="day"/>
                <field name="extraction_pct" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_mos_milling_run_graph_volume" model="ir.ui.view">
        <field name="name">mos.milling.run.graph.volume</field>
        <field name="model">mos.milling.run</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="run_date" interval="day"/>
                <field name="wheat_kg" type="measure"/>
                <field name="flour_kg" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_mos_milling_run_search" model="ir.ui.view">
        <field name="name">mos.milling.run.search</field>
        <field name="model">mos.milling.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="by_month" string="Month" context="{'group_by': 'run_date:month'}"/>
                    <filter name="by_shift" string="Shift" context="{'group_by': 'shift'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_mos_milling_run" model="ir.actions.act_window">
        <field name="name">Milling runs</field>
        <field name="res_model">mos.milling.run</field>
        <field name="view_mode">list,form,graph</field>
    </record>
    <record id="action_mos_extraction_trend" model="ir.actions.act_window">
        <field name="name">Extraction rate trend</field>
        <field name="res_model">mos.milling.run</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_mos_milling_run_graph"/>
        <field name="domain">[('state', '=', 'done')]</field>
    </record>
    <record id="action_mos_milling_volume" model="ir.actions.act_window">
        <field name="name">Wheat milled and flour made</field>
        <field name="res_model">mos.milling.run</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_mos_milling_run_graph_volume"/>
        <field name="domain">[('state', '=', 'done')]</field>
    </record>
    <menuitem id="menu_mos_production" name="Production" parent="mos_core.menu_mos_root" sequence="40"/>
    <menuitem id="menu_mos_milling_runs" name="Milling runs" parent="menu_mos_production" action="action_mos_milling_run" sequence="10"/>
    <menuitem id="menu_mos_extraction_trend" name="Extraction trend" parent="menu_mos_production" action="action_mos_extraction_trend" sequence="20"/>
    <menuitem id="menu_mos_milling_volume" name="Wheat milled and flour made" parent="menu_mos_production" action="action_mos_milling_volume" sequence="30"/>
</odoo>
