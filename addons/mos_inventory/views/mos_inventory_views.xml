<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_mos_inventory" name="Inventory control" parent="mos_core.menu_mos_root" sequence="40"/>

    <!-- Adjustments -->
    <record id="view_mos_stock_adjustment_list" model="ir.ui.view">
        <field name="name">mos.stock.adjustment.list</field>
        <field name="model">mos.stock.adjustment</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="location_id"/><field name="reason_id"/><field name="amount"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_mos_stock_adjustment_form" model="ir.ui.view">
        <field name="name">mos.stock.adjustment.form</field>
        <field name="model">mos.stock.adjustment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply" string="Apply to stock" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('applied', 'rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,applied"/>
                </header>
                <sheet>
                    <div class="mos-page-head">
                        <span class="mos-page-icon"><i class="mos-ico mos-ico-scales"/></span>
                        <div class="mos-page-title"><h2>Stock Adjustment</h2><p>Review the adjustment details and post the transaction to update inventory.</p></div>
                        <div class="mos-page-crumb">Inventory › Stock Adjustment</div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-doc"/> Adjustment Information</div>
                        <div class="mos-fieldgrid">
                            <div><label for="name" string="Adjustment no."/><field name="name"/></div>
                            <div><label for="site_id"/><field name="site_id" readonly="state != 'draft'" options="{'no_create': True}"/></div>
                            <div><label for="location_id" string="Storage location"/><field name="location_id" readonly="state != 'draft'" options="{'no_create': True}"/></div>
                            <div><label for="adjustment_type"/><field name="adjustment_type" widget="badge" decoration-success="adjustment_type == 'increase'" decoration-danger="adjustment_type == 'decrease'" decoration-warning="adjustment_type == 'mixed'"/></div>
                            <div><label for="date" string="Adjustment date"/><field name="date" readonly="state != 'draft'"/></div>
                            <div><label for="requested_by_id" string="Created by"/><field name="requested_by_id"/></div>
                            <div><label for="approved_by_id"/><field name="approved_by_id"/></div>
                            <div><label for="reason_id" string="Reason"/><field name="reason_id" readonly="state != 'draft'" options="{'no_create': True}"/></div>
                            <div class="mos-fieldgrid-wide"><label for="note" string="Comments"/><field name="note" readonly="state != 'draft'" placeholder="Add any additional notes or comments..."/></div>
                            <div invisible="not cycle_count_id"><label for="cycle_count_id" string="From the count"/><field name="cycle_count_id"/></div>
                            <div><label for="amount" string="Value of the change"/><field name="amount"/></div>
                        </div>
                    </div>
                    <div class="mos-summary-row mos-summary-5">
                        <div class="mos-sum-card"><div class="mos-sum-label">Total items</div><div class="mos-sum-value"><field name="item_count"/></div></div>
                        <div class="mos-sum-card mos-sum-ok"><div class="mos-sum-label">Total increase</div><div class="mos-sum-value"><field name="increase_totals"/></div></div>
                        <div class="mos-sum-card mos-sum-bad"><div class="mos-sum-label">Total decrease</div><div class="mos-sum-value"><field name="decrease_totals"/></div></div>
                        <div class="mos-sum-card"><div class="mos-sum-label">Total system qty (before)</div><div class="mos-sum-value"><field name="before_totals"/></div></div>
                        <div class="mos-sum-card"><div class="mos-sum-label">Total system qty (after)</div><div class="mos-sum-value"><field name="after_totals"/></div></div>
                    </div>
                    <div class="mos-section">
                        <div class="mos-section-title"><i class="mos-ico mos-ico-cube"/> Adjustment Items</div>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="code" string="Item code"/>
                                <field name="product_id" string="Item name"/>
                                <field name="uom_id" string="UOM"/>
                                <field name="system_qty" string="System qty (before)"/>
                                <field name="new_qty" string="Physical qty"/>
                                <field name="delta" string="Difference" decoration-success="delta &gt; 0" decoration-danger="delta &lt; 0"/>
                            </list>
                        </field>
                    </div>
                    <div class="mos-split">
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-clipboard"/> Adjustment Summary</div>
                            <div class="mos-summary-row">
                                <div><div class="mos-sum-label">Total increase</div><div class="mos-sum-value mos-sum-green"><field name="increase_totals"/></div></div>
                                <div><div class="mos-sum-label">Total decrease</div><div class="mos-sum-value mos-sum-red"><field name="decrease_totals"/></div></div>
                                <div><div class="mos-sum-label">Net adjustment</div><div class="mos-sum-value"><field name="net_totals"/></div></div>
                            </div>
                        </div>
                        <div class="mos-section">
                            <div class="mos-section-title"><i class="mos-ico mos-ico-info"/> Before posting, please ensure</div>
                            <ul class="mos-notes">
                                <li>All items are selected correctly.</li>
                                <li>The counted quantity is entered.</li>
                                <li>The reason and remarks are provided.</li>
                                <li>Required approvals are completed.</li>
                            </ul>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_stock_adjustment" model="ir.actions.act_window">
        <field name="name">Stock adjustments</field>
        <field name="res_model">mos.stock.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Cycle counts -->
    <record id="view_mos_cycle_count_list" model="ir.ui.view">
        <field name="name">mos.cycle.count.list</field>
        <field name="model">mos.cycle.count</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="location_id"/><field name="counter_id"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_mos_cycle_count_form" model="ir.ui.view">
        <field name="name">mos.cycle.count.form</field>
        <field name="model">mos.cycle.count</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start counting" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit count" type="object" class="btn-primary" invisible="state != 'counting'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="site_id"/>
                        <field name="location_id"/>
                        <field name="counter_id"/>
                        <field name="adjustment_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id" readonly="1"/>
                            <field name="system_qty"/>
                            <field name="counted_qty"/>
                            <field name="variance"/>
                            <field name="counted" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_cycle_count" model="ir.actions.act_window">
        <field name="name">Cycle counts</field>
        <field name="res_model">mos.cycle.count</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Status changes -->
    <record id="view_mos_status_change_list" model="ir.ui.view">
        <field name="name">mos.stock.status.change.list</field>
        <field name="model">mos.stock.status.change</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="product_id"/><field name="qty"/><field name="from_status"/><field name="to_status"/><field name="reason_id"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_mos_status_change_form" model="ir.ui.view">
        <field name="name">mos.stock.status.change.form</field>
        <field name="model">mos.stock.status.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply" string="Move the stock" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="from_status"/>
                            <field name="to_status"/>
                            <field name="reason_id"/>
                            <field name="note"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="picking_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mos_status_change" model="ir.actions.act_window">
        <field name="name">Quarantine and blocked stock</field>
        <field name="res_model">mos.stock.status.change</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Reorder -->
    <record id="view_mos_reorder_list" model="ir.ui.view">
        <field name="name">mos.reorder.report.list</field>
        <field name="model">mos.reorder.report</field>
        <field name="arch" type="xml">
            <list decoration-danger="shortfall &gt; 0 or below_safety" create="0">
                <field name="product_id"/>
                <field name="safety_stock"/>
                <field name="reorder_min"/>
                <field name="max_level"/>
                <field name="on_hand"/>
                <field name="on_order"/>
                <field name="shortfall"/>
                <field name="suggested_qty"/>
            </list>
        </field>
    </record>
    <record id="action_mos_reorder" model="ir.actions.act_window">
        <field name="name">Reorder report</field>
        <field name="res_model">mos.reorder.report</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_product_template_form_mos_inventory" model="ir.ui.view">
        <field name="name">product.template.form.mos.inventory</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="mos_reorder_min"/>
                <field name="mos_reorder_qty"/>
                <field name="mos_safety_stock"/>
                <field name="mos_max_level"/>
            </xpath>
        </field>
    </record>
    <record id="view_location_form_mos_inventory" model="ir.ui.view">
        <field name="name">stock.location.form.mos.inventory</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="mos_stock_status"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_mos_stock_adjustments" name="Stock adjustments" parent="menu_mos_inventory" action="action_mos_stock_adjustment" sequence="10"/>
    <menuitem id="menu_mos_cycle_counts" name="Cycle counts" parent="menu_mos_inventory" action="action_mos_cycle_count" sequence="20"/>
    <menuitem id="menu_mos_status_changes" name="Quarantine and blocked stock" parent="menu_mos_inventory" action="action_mos_status_change" sequence="30"/>
    <menuitem id="menu_mos_reorder" name="Reorder report" parent="menu_mos_inventory" action="action_mos_reorder" sequence="40"/>
</odoo>
